{
  "rewrites": [
    { "source": "/fristenrechner", "destination": "/fristenrechner.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=()" }
      ]
    }
  ]
}
